diff --git a/drivers/accessibility/speakup/speakup.h b/drivers/accessibility/speakup/speakup.h
index b53c651..983e5e5 100644
--- a/drivers/accessibility/speakup/speakup.h
+++ b/drivers/accessibility/speakup/speakup.h
@@ -35,10 +35,44 @@
 #define B_SYM 0x0800
 #define B_CAPSYM (B_CAP | B_SYM)
 
-/* FIXME: u16 */
-#define IS_WDLM(x) (spk_chartab[((u_char)x)] & B_WDLM)
-#define IS_CHAR(x, type) (spk_chartab[((u_char)x)] & type)
-#define IS_TYPE(x, type) ((spk_chartab[((u_char)x)] & type) == type)
+/*
+ * spk_chartab[] and spk_characters[] are indexed by the code point itself and
+ * therefore describe Latin-1 only.  A code point above Latin-1 is described by
+ * an entry in the extended character table instead.  The extended character
+ * table is kept sorted by code point and is searched with a binary search.
+ */
+struct spk_ext_char {
+	u32 ch;			/* code point, always at or above 0x100 */
+	u_short type;		/* character class bits, as in spk_chartab */
+	char *desc;		/* spoken description, or NULL for none */
+	bool desc_allocated;	/* desc was allocated and must be freed */
+};
+
+/*
+ * Everything Speakup knows about one code point, gathered by a single table
+ * lookup.  Naming a character needs the class bits and the description
+ * together, so returning both at once keeps one lookup per code point instead
+ * of one lookup per field.
+ */
+struct spk_char_info {
+	char *desc;		/* spoken description, or NULL for none */
+	u_short type;		/* character class bits, as in spk_chartab */
+};
+
+extern struct spk_ext_char *spk_ext_chars;
+extern int spk_ext_chars_used;
+
+int spk_ext_char_index(u32 ch);
+struct spk_char_info spk_char_info(u32 ch);
+u_short spk_char_type(u32 ch);
+int spk_ext_char_set_desc(u32 ch, char *desc);
+int spk_ext_char_set_type(u32 ch, u_short type);
+int spk_reset_default_ext_chars(void);
+void spk_free_ext_chars(void);
+
+#define IS_WDLM(x) (spk_char_type(x) & B_WDLM)
+#define IS_CHAR(x, type) (spk_char_type(x) & type)
+#define IS_TYPE(x, type) ((spk_char_type(x) & type) == type)
 
 int speakup_thread(void *data);
 void spk_reset_default_chars(void);
