@@ -1160,10 +1344,7 @@ static void spkup_write(const u32 *in_buf, int count)
 		 */
 		if (ch == SPK_UC_WIDE_FILL)
 			continue;
-		if (ch < 0x100)
-			char_type = spk_chartab[ch];
-		else
-			char_type = ALPHA;
