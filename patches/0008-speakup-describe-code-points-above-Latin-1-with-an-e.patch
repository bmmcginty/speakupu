@@ -2424,6 +2605,7 @@ static void __exit speakup_exit(void)
 			kfree(spk_characters[i]);
 	}
 
+	spk_free_ext_chars();
 	spk_free_user_msgs();
 }
 
@@ -2439,6 +2621,9 @@ static int __init speakup_init(void)
 	spk_initialize_msgs();	/* Initialize arrays for i18n. */
